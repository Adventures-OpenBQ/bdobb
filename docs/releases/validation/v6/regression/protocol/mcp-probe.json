  {
   "_meta": {
    "fastmcp": {
     "tags": [
      "admin"
     ]
    }
   },
   "description": "Run tools in sequence on the server, feeding the `results` of earlier steps (their whole output when they have none) into the arguments of later ones, so data such as a price history never passes through the conversation. Use it to chain a data tool into a data-processing tool (technical, quantitative, econometrics), which takes its input rows as `data`. Each step names a `tool`, its `arguments`, an optional `id`, and `inputs` mapping argument names to earlier step ids. Returns the output of the last step, or of the steps listed in `outputs`, keyed by step id (or position). Example: steps=[{\"id\": \"prices\", \"tool\": \"equity_price_historical\", \"arguments\": {\"symbol\": \"AAPL\", \"provider\": \"yfinance\"}}, {\"tool\": \"technical_rsi\", \"arguments\": {\"length\": 14}, \"inputs\": {\"data\": \"prices\"}}].",
   "inputSchema": {
    "properties": {
     "steps": {
      "description": "The tool calls to run, in order.",
      "items": {
       "description": "One tool call in a ``run_pipeline`` request.",
       "properties": {
        "id": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null,
         "description": "Name later steps use in ``inputs`` to refer to this step."
        },
        "tool": {
         "description": "Name of the tool to call.",
         "type": "string"
        },
        "arguments": {
         "additionalProperties": true,
         "description": "Arguments passed to the tool.",
         "type": "object"
        },
        "inputs": {
         "additionalProperties": {
          "type": "string"
         },
         "description": "Maps an argument name to the ``id`` of an earlier step whose ``results`` fill it, e.g. ``{\"data\": \"prices\"}``.",
         "type": "object"
        }
       },
       "required": [
        "tool"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "outputs": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Ids (or positions) of the steps whose outputs are returned. Defaults to the last step."
     }
    },
    "required": [
     "steps"
    ],
    "type": "object",
    "additionalProperties": false
   },
   "name": "run_pipeline",
   "outputSchema": {
    "type": "object",
    "additionalProperties": true
   },
   "title": "Run Pipeline"
  },
