        "id": "01-install-desk",
        "name": "01-install-desk",
        "layout": [
          {
            "i": "eodhd_equity_price_historical_eodhd_obb",
            "x": 0,
            "y": 2,
            "w": 40,
            "h": 12,
            "state": {
              "params": {
                "symbol": "NVDA",
                "interval": "1d",
                "exchange": "US",
                "provider": "eodhd"
              }
            }
          }
        ]
