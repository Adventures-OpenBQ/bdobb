            }
          },
          {
            "ref": "c1",
            "tab": "auctions",
            "index": 1,
            "extras": {
              "calendar": {
                "mode": "static",
                "unit": "month",
                "dateField": "auction_date",
                "titleField": "security_term",
                "seriesField": "security_type"
              },
              "view": "calendar"
            }
          }
        ]
      }
    }
