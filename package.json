{
  "name": "bdobb",
  "private": true,
  "version": "8.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "tauri dev",
    "build": "vite build",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "capabilities": "node scripts/generate-capabilities.mjs",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:workspace": "WORKSPACE_TEST=1 vitest run src/test/integration/workspace-login.test.ts",
    "test:dashsync": "DASHSYNC_TEST=1 playwright test e2e/dashboard-sync.spec.ts",
    "test:reference": "OPENBB_REFERENCE=1 vitest run src/test/integration/reference-backend.test.ts",
    "scrub": "bash scripts/scrub-check.sh && bash scripts/header-check.sh",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "release": "bash scripts/release.sh",
    "reference-backend": "bash scripts/reference-backend.sh",
    "tauri": "tauri",
    "smoke": "node scripts/smoke.mjs",
    "help:shots": "node scripts/help-shots.mjs",
    "help:sync": "node scripts/help-sync.mjs",
    "ios:check": "bash scripts/ios.sh check",
    "ios:init": "bash scripts/ios.sh init",
    "ios:team": "bash scripts/ios.sh team",
    "ios:dev": "bash scripts/ios.sh dev",
    "ios:build": "bash scripts/ios.sh build",
    "ios:sim": "bash scripts/ios.sh sim",
    "e2e": "playwright test",
    "apps:sync": "node scripts/apps-sync.mjs",
    "e2e:headed": "playwright test --headed",
    "gateway:vendor": "node scripts/gateway-vendor.mjs",
    "build:web": "node scripts/build-web.mjs",
    "test:web": "node --test web/*.test.mjs",
    "web:serve": "node web/local.mjs",
    "test:web:browser": "node web/browser-smoke.mjs",
    "test:live": "bash scripts/rita-live-check.sh",
    "pivot:build": "node scripts/build-pivot-wasm.mjs",
    "pivot:test": "cargo +1.98.1 test --locked --manifest-path crates/pivot-core/Cargo.toml && cargo +1.98.1 test --locked --manifest-path crates/pivot-wasm/Cargo.toml && vitest run src/lib/tableExecution/rust/wireCodec.test.ts",
    "pivot:verify": "node scripts/build-pivot-wasm.mjs --verify",
    "test:pivot:packaging": "node --test scripts/pivot-packaging.test.mjs",
    "test:pivot:browser": "playwright test --config playwright.pivot.config.ts",
    "table-ingest:build": "node scripts/build-table-ingest.mjs",
    "table-ingest:typecheck": "tsc --noEmit -p server/table-ingest/tsconfig.json",
    "table-ingest:test": "vitest run server/table-ingest",
    "test:ssrm:browser": "node scripts/run-ssrm-browser.mjs"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@blocknote/core": "0.54.0",
    "@blocknote/mantine": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lightweight-charts": "5.0.8",
    "pdfjs-dist": "5.7.284",
    "plotly.js": "^3.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^1.5.0",
    "react-markdown": "^10.1.0",
    "react-resizable": "^3.0.5",
    "remark-gfm": "^4.0.1",
    "ws": "8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz#sha512-oLDq3jw7AcLqKWH2AhCpVTZl8mf6X2YReP+Neh0SJUzV/BdZYjth94tG5toiMB1PPrYtxOCfaoUCkvtuH+3AJA==",
    "zustand": "^5.0.2",
    "@internationalized/date": "^3.12.4",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/plotly.js": "^3.0.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.70.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "openbbDocker": "v3.0.1",
  "openbqDocker": "57812e6b8a3a4cdad291388c43c60e5878396948"
}
