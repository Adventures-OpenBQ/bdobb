{
  "$defs": {
    "AcquisitionAssumptions": {
      "additionalProperties": false,
      "properties": {
        "freshness_seconds": {
          "maximum": 2678400,
          "minimum": 60,
          "title": "Freshness Seconds",
          "type": "integer"
        },
        "mappings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AcquisitionMapping"
          },
          "maxItems": 16,
          "title": "Mappings",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/AcquisitionSourceAssumption"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "freshness_seconds",
        "sources"
      ],
      "title": "AcquisitionAssumptions",
      "type": "object"
    },
    "AcquisitionCoverageReference": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "format": "uuid",
          "title": "Capture Id",
          "type": "string"
        },
        "catalog_id": {
          "maxLength": 63,
          "minLength": 1,
          "title": "Catalog Id",
          "type": "string"
        },
        "dataset_id": {
          "enum": [
            "eodhd.eod",
            "yfinance.YfinanceEquityHistorical"
          ],
          "title": "Dataset Id",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "normalizer_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Normalizer Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "publication_id": {
          "format": "uuid",
          "title": "Publication Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "symbol": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._^=\\-]{0,63}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "capture_id",
        "publication_id",
        "normalizer_version",
        "catalog_id",
        "dataset_id",
        "symbol",
        "start_date",
        "end_date",
        "observed_at",
        "expires_at"
      ],
      "title": "AcquisitionCoverageReference",
      "type": "object"
    },
    "AcquisitionExplanation": {
      "additionalProperties": false,
      "description": "Frozen evidence, not permission or a count of SDK-internal HTTP requests.",
      "properties": {
        "assumptions": {
          "$ref": "#/$defs/AcquisitionAssumptions"
        },
        "decision": {
          "enum": [
            "cache_hit",
            "provider_backed"
          ],
          "title": "Decision",
          "type": "string"
        },
        "execution_id": {
          "format": "uuid",
          "title": "Execution Id",
          "type": "string"
        },
        "policy_id": {
          "format": "uuid",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "provider_operations": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Provider Operations",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "selected_coverage": {
          "items": {
            "$ref": "#/$defs/AcquisitionCoverageReference"
          },
          "maxItems": 4096,
          "title": "Selected Coverage",
          "type": "array"
        }
      },
      "required": [
        "execution_id",
        "run_id",
        "policy_id",
        "policy_revision",
        "decision",
        "provider_operations",
        "assumptions",
        "selected_coverage"
      ],
      "title": "AcquisitionExplanation",
      "type": "object"
    },
    "AcquisitionLimits": {
      "additionalProperties": false,
      "properties": {
        "coverage_reads": {
          "default": 128,
          "maximum": 4096,
          "minimum": 1,
          "title": "Coverage Reads",
          "type": "integer"
        },
        "freshness_seconds": {
          "default": 86400,
          "maximum": 2678400,
          "minimum": 60,
          "title": "Freshness Seconds",
          "type": "integer"
        },
        "max_bytes": {
          "default": 67108864,
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_concurrency": {
          "default": 2,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "max_days": {
          "default": 3660,
          "maximum": 36600,
          "minimum": 1,
          "title": "Max Days",
          "type": "integer"
        },
        "max_identities": {
          "default": 25,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Identities",
          "type": "integer"
        },
        "max_requests": {
          "default": 32,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_retries": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "negative_ttl_seconds": {
          "default": 3600,
          "maximum": 604800,
          "minimum": 60,
          "title": "Negative Ttl Seconds",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "AcquisitionLimits",
      "type": "object"
    },
    "AcquisitionMapping": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "enum": [
            "eodhd.eod",
            "yfinance.YfinanceEquityHistorical"
          ],
          "title": "Dataset Id",
          "type": "string"
        },
        "end_parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "End Parameter",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_alias": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Source Alias",
          "type": "string"
        },
        "start_parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Start Parameter",
          "type": "string"
        },
        "symbol_parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Symbol Parameter",
          "type": "string"
        }
      },
      "required": [
        "source_alias",
        "dataset_id",
        "symbol_parameter",
        "start_parameter",
        "end_parameter"
      ],
      "title": "AcquisitionMapping",
      "type": "object"
    },
    "AcquisitionPolicy": {
      "additionalProperties": false,
      "description": "Versioned assumptions; current revision and scoped grants are checked separately.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/$defs/AcquisitionLimits"
        },
        "mappings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AcquisitionMapping"
          },
          "maxItems": 16,
          "title": "Mappings",
          "type": "array"
        },
        "policy_id": {
          "format": "uuid",
          "title": "Policy Id",
          "type": "string"
        },
        "revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/AcquisitionSource"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "revision",
        "title",
        "sources"
      ],
      "title": "AcquisitionPolicy",
      "type": "object"
    },
    "AcquisitionPolicySummary": {
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "items": {
            "enum": [
              "eodhd.eod",
              "yfinance.YfinanceEquityHistorical"
            ],
            "type": "string"
          },
          "title": "Datasets",
          "type": "array"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "policy_id": {
          "format": "uuid",
          "title": "Policy Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "revision",
        "title",
        "enabled",
        "datasets"
      ],
      "title": "AcquisitionPolicySummary",
      "type": "object"
    },
    "AcquisitionRunHandle": {
      "additionalProperties": false,
      "description": "Ready means an immutable execution was created; its execution state remains separate.",
      "properties": {
        "context": {
          "$ref": "#/$defs/TemporalContext"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "execution_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Id"
        },
        "policy_id": {
          "format": "uuid",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_revision": {
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "resolved_params": {
          "additionalProperties": true,
          "maxProperties": 128,
          "title": "Resolved Params",
          "type": "object"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stage": {
          "maxLength": 64,
          "title": "Stage",
          "type": "string"
        },
        "state": {
          "enum": [
            "waiting",
            "acquiring",
            "normalizing",
            "ready",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "state",
        "policy_id",
        "policy_revision",
        "submitted_at",
        "deadline",
        "context",
        "stage"
      ],
      "title": "AcquisitionRunHandle",
      "type": "object"
    },
    "AcquisitionRunRequest": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/TemporalContext"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "maxProperties": 128,
          "title": "Params",
          "type": "object"
        },
        "policy_id": {
          "format": "uuid",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "query_id": {
          "format": "uuid",
          "title": "Query Id",
          "type": "string"
        },
        "revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "query_id",
        "revision",
        "context",
        "policy_id",
        "policy_revision",
        "idempotency_key"
      ],
      "title": "AcquisitionRunRequest",
      "type": "object"
    },
    "AcquisitionSource": {
      "additionalProperties": false,
      "description": "Allowed acquisition identities and request bounds, not proof of effective data coverage.",
      "properties": {
        "account_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Account Ref",
          "type": "string"
        },
        "dataset_id": {
          "enum": [
            "eodhd.eod",
            "yfinance.YfinanceEquityHistorical"
          ],
          "title": "Dataset Id",
          "type": "string"
        },
        "date_end": {
          "format": "date",
          "title": "Date End",
          "type": "string"
        },
        "date_start": {
          "format": "date",
          "title": "Date Start",
          "type": "string"
        },
        "provider": {
          "enum": [
            "eodhd",
            "yfinance"
          ],
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "symbols": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._^=\\-]{0,63}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Symbols",
          "type": "array"
        }
      },
      "required": [
        "dataset_id",
        "provider",
        "account_ref",
        "symbols",
        "date_start",
        "date_end"
      ],
      "title": "AcquisitionSource",
      "type": "object"
    },
    "AcquisitionSourceAssumption": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "enum": [
            "eodhd.eod",
            "yfinance.YfinanceEquityHistorical"
          ],
          "title": "Dataset Id",
          "type": "string"
        },
        "date_end": {
          "format": "date",
          "title": "Date End",
          "type": "string"
        },
        "date_start": {
          "format": "date",
          "title": "Date Start",
          "type": "string"
        },
        "provider": {
          "enum": [
            "eodhd",
            "yfinance"
          ],
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "dataset_id",
        "provider",
        "date_start",
        "date_end"
      ],
      "title": "AcquisitionSourceAssumption",
      "type": "object"
    },
    "CaptureAck": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "format": "uuid",
          "title": "Capture Id",
          "type": "string"
        },
        "durable": {
          "title": "Durable",
          "type": "boolean"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "capture_id",
        "payload_sha256",
        "durable"
      ],
      "title": "CaptureAck",
      "type": "object"
    },
    "CaptureEnvelope": {
      "additionalProperties": false,
      "description": "Internal binary capture, never accepted as a public JSON request.",
      "properties": {
        "adapter_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:/+-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "body": {
          "format": "binary",
          "title": "Body",
          "type": "string"
        },
        "capture_id": {
          "format": "uuid",
          "title": "Capture Id",
          "type": "string"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "representation": {
          "title": "Representation",
          "type": "string"
        },
        "request": {
          "additionalProperties": true,
          "title": "Request",
          "type": "object"
        },
        "request_duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Duration Ms"
        },
        "request_started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Started At"
        },
        "response_headers": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Headers"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/RequestScope"
        },
        "transport_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureTransportOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "capture_id",
        "scope",
        "provider",
        "endpoint",
        "request",
        "body",
        "http_status",
        "received_at",
        "representation"
      ],
      "title": "CaptureEnvelope",
      "type": "object",
      "x-internal": true
    },
    "CaptureTransportOutcome": {
      "additionalProperties": false,
      "description": "Observed response content that cannot authorize normalization.",
      "properties": {
        "body_complete": {
          "title": "Body Complete",
          "type": "boolean"
        },
        "byte_limit": {
          "exclusiveMinimum": 0,
          "title": "Byte Limit",
          "type": "integer"
        },
        "observed_bytes": {
          "minimum": 0,
          "title": "Observed Bytes",
          "type": "integer"
        },
        "reason": {
          "enum": [
            "byte_limit",
            "unsupported_content_encoding",
            "incomplete_response"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "body_complete",
        "observed_bytes",
        "byte_limit"
      ],
      "title": "CaptureTransportOutcome",
      "type": "object"
    },
    "CapturedResponse": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "format": "binary",
          "title": "Body",
          "type": "string"
        },
        "capture_id": {
          "format": "uuid",
          "title": "Capture Id",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "capture_id",
        "body",
        "stale",
        "received_at"
      ],
      "title": "CapturedResponse",
      "type": "object"
    },
    "CatalogPin": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "minLength": 1,
          "title": "Catalog Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "snapshot_id": {
          "minimum": 0,
          "title": "Snapshot Id",
          "type": "integer"
        }
      },
      "required": [
        "catalog_id",
        "snapshot_id"
      ],
      "title": "CatalogPin",
      "type": "object"
    },
    "ColumnSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "default": true,
          "title": "Nullable",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
