{
  "$defs": {
    "CaptureAck": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "format": "uuid",
          "title": "Capture Id",
          "type": "string"
        },
        "durable": {
          "title": "Durable",
          "type": "boolean"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "capture_id",
        "payload_sha256",
        "durable"
      ],
      "title": "CaptureAck",
      "type": "object"
    },
    "CaptureEnvelope": {
      "additionalProperties": false,
      "description": "Internal binary capture, never accepted as a public JSON request.",
      "properties": {
        "adapter_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:/+-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "body": {
          "format": "binary",
          "title": "Body",
          "type": "string"
        },
        "capture_id": {
          "format": "uuid",
          "title": "Capture Id",
          "type": "string"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "representation": {
          "title": "Representation",
          "type": "string"
        },
        "request": {
          "additionalProperties": true,
          "title": "Request",
          "type": "object"
        },
        "request_duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Duration Ms"
        },
        "request_started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Started At"
        },
        "response_headers": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Headers"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/RequestScope"
        },
        "transport_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureTransportOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "capture_id",
        "scope",
        "provider",
        "endpoint",
        "request",
        "body",
        "http_status",
        "received_at",
        "representation"
      ],
      "title": "CaptureEnvelope",
      "type": "object",
      "x-internal": true
    },
    "CaptureTransportOutcome": {
      "additionalProperties": false,
      "description": "Observed response content that cannot authorize normalization.",
      "properties": {
        "body_complete": {
          "title": "Body Complete",
          "type": "boolean"
        },
        "byte_limit": {
          "exclusiveMinimum": 0,
          "title": "Byte Limit",
          "type": "integer"
        },
        "observed_bytes": {
          "minimum": 0,
          "title": "Observed Bytes",
          "type": "integer"
        },
        "reason": {
          "enum": [
            "byte_limit",
            "unsupported_content_encoding",
            "incomplete_response"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "body_complete",
        "observed_bytes",
        "byte_limit"
      ],
      "title": "CaptureTransportOutcome",
      "type": "object"
    },
    "CapturedResponse": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "format": "binary",
          "title": "Body",
          "type": "string"
        },
        "capture_id": {
          "format": "uuid",
          "title": "Capture Id",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "capture_id",
        "body",
        "stale",
        "received_at"
      ],
      "title": "CapturedResponse",
      "type": "object"
    },
    "CatalogPin": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "minLength": 1,
          "title": "Catalog Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "snapshot_id": {
          "minimum": 0,
          "title": "Snapshot Id",
          "type": "integer"
        }
      },
      "required": [
        "catalog_id",
        "snapshot_id"
      ],
      "title": "CatalogPin",
      "type": "object"
    },
    "ColumnSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "default": true,
          "title": "Nullable",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "timestamp",
            "uuid",
            "json"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ColumnSpec",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "logical_range": {
          "additionalProperties": true,
          "title": "Logical Range",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "withdrawal_evidence": {
          "title": "Withdrawal Evidence",
          "type": "boolean"
        }
      },
      "required": [
        "complete",
        "logical_range",
        "withdrawal_evidence"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DatasetCapabilities": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "knowledge_bases": {
                "contains": {
                  "const": "provider_published"
                }
              }
            },
            "required": [
              "knowledge_bases"
            ]
          },
          "then": {
            "properties": {
              "publication_precision": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "publication_precision"
            ]
          }
        }
      ],
      "properties": {
        "capture_representation": {
          "title": "Capture Representation",
          "type": "string"
        },
        "correction_coverage": {
          "title": "Correction Coverage",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "knowledge_bases": {
          "items": {
            "enum": [
              "local_received",
              "provider_published"
            ],
            "type": "string"
          },
          "title": "Knowledge Bases",
          "type": "array"
        },
        "publication_precision": {
          "anyOf": [
            {
              "enum": [
                "date",
                "timestamp"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Precision"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "dataset_id",
        "capture_representation",
        "knowledge_bases",
        "correction_coverage"
      ],
      "title": "DatasetCapabilities",
      "type": "object"
    },
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/TemporalError"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "InputManifest": {
      "additionalProperties": false,
      "properties": {
        "manifest_id": {
          "format": "uuid",
          "title": "Manifest Id",
          "type": "string"
        },
        "pins": {
          "items": {
            "$ref": "#/$defs/CatalogPin"
          },
          "title": "Pins",
          "type": "array"
        },
        "projection_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Projection Versions",
          "type": "object"
        },
        "publication_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_manifests": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/InputManifest"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Manifests"
        }
      },
      "required": [
        "manifest_id",
        "pins",
        "projection_versions"
      ],
      "title": "InputManifest",
      "type": "object"
    },
    "ParameterSpec": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "default": null,
          "title": "Default"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "timestamp",
            "uuid"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ParameterSpec",
      "type": "object"
    },
    "ProviderRequest": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "endpoint",
        "parameters"
      ],
      "title": "ProviderRequest",
      "type": "object"
    },
    "QueryDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "kind": {
          "enum": [
            "dataset",
            "sql"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          },
          "title": "Parameters",
          "type": "array"
        },
        "presentation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Presentation"
        },
        "query_id": {
          "format": "uuid",
          "title": "Query Id",
          "type": "string"
        },
        "request": {
          "additionalProperties": true,
          "title": "Request",
          "type": "object"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_expectation": {
          "items": {
            "$ref": "#/$defs/ColumnSpec"
          },
          "title": "Schema Expectation",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "temporal": {
          "$ref": "#/$defs/TemporalContext"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "revision",
        "title",
        "kind",
        "parameters",
        "request",
        "temporal",
        "schema_expectation"
      ],
      "title": "QueryDefinition",
      "type": "object"
    },
    "RequestScope": {
      "additionalProperties": false,
      "description": "Internal server-policy value. HTTP handlers must derive this after authentication.",
      "properties": {
        "entitlement_id": {
          "title": "Entitlement Id",
          "type": "string"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "entitlement_id",
        "principal_id"
      ],
      "title": "RequestScope",
      "type": "object"
    },
    "TemporalContext": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "known_at"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "knowledge_basis": {
                "not": {
                  "type": "null"
                }
              },
              "known_at": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "known_at",
              "knowledge_basis"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "effective_on"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "effective_at": {
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "effective_at"
                ]
              },
              {
                "properties": {
                  "date_range": {
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "date_range"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "properties": {
              "date_range": {
                "not": {
                  "type": "null"
                }
              },
              "effective_at": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "effective_at",
              "date_range"
            ]
          }
        }
      ],
      "properties": {
        "date_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effective_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective At"
        },
        "knowledge_basis": {
          "anyOf": [
            {
              "enum": [
                "local_received",
                "provider_published"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Basis"
        },
        "known_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known At"
        },
        "mode": {
          "enum": [
            "current_corrected",
            "known_at",
            "effective_on",
            "snapshot"
          ],
          "title": "Mode",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "mode"
      ],
      "title": "TemporalContext",
      "type": "object"
    },
    "TemporalError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "CAPTURE_UNAVAILABLE",
            "NO_CAPTURED_VALUE",
            "TEMPORAL_MODE_UNSUPPORTED",
            "PUBLICATION_HISTORY_UNAVAILABLE",
            "VERSION_NOT_RETAINED",
            "CONSISTENT_INPUT_UNAVAILABLE",
            "REVISION_CONFLICT",
            "EXECUTION_UNAVAILABLE",
            "ACCESS_DENIED",
            "QUERY_REJECTED",
            "LEASE_LOST",
            "IDEMPOTENCY_CONFLICT",
            "CAPABILITY_UNAVAILABLE",
            "RESOURCE_LIMIT"
          ],
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "title": "TemporalError",
      "type": "object"
    }
  },
  "$id": "urn:temporaldb:contracts:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemporalDB v1 contracts"
}
