event: message
data: {"jsonrpc":"2.0","id":2,"result":{"tools":[{"_meta":{"fastmcp":{"tags":["admin"]}},"description":"List available tool categories and subcategories with tool counts.","inputSchema":{"properties":{},"type":"object","additionalProperties":false},"name":"available_categories","outputSchema":{"properties":{"result":{"items":{"description":"Metadata for a category of tools.","properties":{"name":{"type":"string"},"subcategories":{"items":{"description":"Metadata for a tool subcategory.","properties":{"name":{"type":"string"},"tool_count":{"type":"integer"}},"required":["name","tool_count"],"type":"object"},"type":"array"},"total_tools":{"type":"integer"}},"required":["name","subcategories","total_tools"],"type":"object"},"type":"array"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"title":"Available Categories"},{"_meta":{"fastmcp":{"tags":["admin"]}},"description":"List the tools in a category; get their parameters with search_tools and run them with call_tool.","inputSchema":{"properties":{"category":{"description":"The category of tools to list","type":"string"},"subcategory":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Optional subcategory to filter by. Use 'general' for tools directly under the category."}},"required":["category"],"type":"object","additionalProperties":false},"name":"available_tools","outputSchema":{"properties":{"result":{"items":{"description":"Information about a single tool.","properties":{"name":{"type":"string"},"description":{"type":"string"}},"required":["name","description"],"type":"object"},"type":"array"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"title":"Available Tools"},{"_meta":{"fastmcp":{"tags":["admin"]}},"description":"Run tools in sequence on the server, feeding the `results` of earlier steps (their whole output when they have none) into the arguments of later ones, so data such as a price history never passes through the conversation. Use it to chain a data tool into a data-processing tool (technical, quantitative, econometrics), which takes its input rows as `data`. Each step names a `tool`, its `arguments`, an optional `id`, and `inputs` mapping argument names to earlier step ids. Returns the output of the last step, or of the steps listed in `outputs`, keyed by step id (or position). Example: steps=[{\"id\": \"prices\", \"tool\": \"equity_price_historical\", \"arguments\": {\"symbol\": \"AAPL\", \"provider\": \"yfinance\"}}, {\"tool\": \"technical_rsi\", \"arguments\": {\"length\": 14}, \"inputs\": {\"data\": \"prices\"}}].","inputSchema":{"properties":{"steps":{"description":"The tool calls to run, in order.","items":{"description":"One tool call in a ``run_pipeline`` request.","properties":{"id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Name later steps use in ``inputs`` to refer to this step."},"tool":{"description":"Name of the tool to call.","type":"string"},"arguments":{"additionalProperties":true,"description":"Arguments passed to the tool.","type":"object"},"inputs":{"additionalProperties":{"type":"string"},"description":"Maps an argument name to the ``id`` of an earlier step whose ``results`` fill it, e.g. ``{\"data\": \"prices\"}``.","type":"object"}},"required":["tool"],"type":"object"},"minItems":1,"type":"array"},"outputs":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"description":"Ids (or positions) of the steps whose outputs are returned. Defaults to the last step."}},"required":["steps"],"type":"object","additionalProperties":false},"name":"run_pipeline","outputSchema":{"type":"object","additionalProperties":true},"title":"Run Pipeline"},{"_meta":{"fastmcp":{"tags":["admin","resource"]}},"description":"Install a skill (SKILL.md plus supporting files) and make it readable via list_resources and read_resource.","inputSchema":{"properties":{"skill_name":{"description":"Name of the skill (used as the directory name): lowercase letters, digits, underscores, and hyphens.","type":"string"},"files":{"additionalProperties":{"type":"string"},"description":"Dictionary of filename -> content for the skill directory. Filenames are relative paths inside the skill directory. Must include 'SKILL.md' as the main file. May include supporting files such as templates, examples, or configuration snippets (e.g. 'pyproject.toml.template', 'example.py').","type":"object"},"target":{"default":"bundled","description":"Target skills provider to install into. Use 'bundled' for the server's built-in skills directory, or a vendor name: 'claude', 'cursor', 'vscode', 'copilot', 'codex', 'gemini', 'goose', 'opencode'.","type":"string"}},"required":["skill_name","files"],"type":"object","additionalProperties":false},"name":"install_skill","outputSchema":{"type":"object","additionalProperties":true},"title":"Install Skill"},{"_meta":{"fastmcp":{"tags":[]}},"description":"Search for tools using natural language.\n\nReturns matching tool definitions ranked by relevance,\nin the same format as list_tools.","inputSchema":{"properties":{"query":{"description":"Natural language query to search for tools","type":"string"}},"required":["query"],"type":"object","additionalProperties":false},"name":"search_tools","outputSchema":{"properties":{"result":{"anyOf":[{"type":"string"},{"items":{"additionalProperties":true,"type":"object"},"type":"array"}]}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"title":"Search Tools"},{"_meta":{"fastmcp":{"tags":[]}},"description":"Call a tool by name with the given arguments.\n\nUse this to execute tools discovered via search_tools.","inputSchema":{"properties":{"name":{"description":"The name of the tool to call","type":"string"},"arguments":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"description":"Arguments to pass to the tool"}},"required":["name"],"type":"object","additionalProperties":false},"name":"call_tool","title":"Call Tool"},{"_meta":{"fastmcp":{"tags":[]}},"description":"List all available prompts.\n\nReturns JSON with prompt metadata including name, description,\nand optional arguments.","inputSchema":{"properties":{},"type":"object","additionalProperties":false},"name":"list_prompts","outputSchema":{"properties":{"result":{"type":"string"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"title":"List Prompts"},{"_meta":{"fastmcp":{"tags":[]}},"description":"Get a prompt by name with optional arguments.\n\nReturns the rendered prompt as JSON with a messages array.\nArguments should be provided as a dict mapping argument names\nto values.","inputSchema":{"properties":{"name":{"description":"The name of the prompt to get","type":"string"},"arguments":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"description":"Optional arguments for the prompt"}},"required":["name"],"type":"object","additionalProperties":false},"name":"get_prompt","outputSchema":{"properties":{"result":{"type":"string"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"title":"Get Prompt"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"List all available resources and resource templates.\n\nReturns JSON with resource metadata. Static resources have a\n'uri' field, while templates have a 'uri_template' field with\nplaceholders like {name}.","inputSchema":{"properties":{},"type":"object","additionalProperties":false},"name":"list_resources","outputSchema":{"properties":{"result":{"type":"string"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"title":"List Resources"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Read a resource by its URI.\n\nFor static resources, provide the exact URI. For templated\nresources, provide the URI with template parameters filled in.\n\nReturns the resource content as a string. Binary content is\nbase64-encoded.","inputSchema":{"properties":{"uri":{"description":"The URI of the resource to read","type":"string"}},"required":["uri"],"type":"object","additionalProperties":false},"name":"read_resource","outputSchema":{"properties":{"result":{"type":"string"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"title":"Read Resource"}]}}

