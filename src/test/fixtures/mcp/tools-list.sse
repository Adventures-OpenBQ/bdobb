event: message
data: {"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"arctic_list_libraries","description":"List ArcticDB libraries in the store (e.g. 'ticks').","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"},"outputSchema":{"properties":{"result":{"items":{"type":"string"},"type":"array"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"_meta":{"fastmcp":{"tags":[]}}},{"name":"arctic_list_symbols","description":"List symbols stored in an ArcticDB library.","inputSchema":{"additionalProperties":false,"properties":{"library":{"type":"string"}},"required":["library"],"type":"object"},"outputSchema":{"properties":{"result":{"items":{"type":"string"},"type":"array"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"_meta":{"fastmcp":{"tags":[]}}},{"name":"arctic_read","description":"Read a symbol from an ArcticDB library.\n\nstart/end are ISO dates/timestamps filtering the stored index\n(ArcticDB date_range). Returns at most tail_rows rows (the most recent\nones in range, hard cap 10000) as JSON records with ISO timestamps.\n\nThe READ itself is bounded, not just the response: with no start/end\nthis uses ArcticDB's native `Library.tail(symbol, n)` so an unfiltered\ncall never materializes the whole symbol. With start/end, ArcticDB's\nstorage-level date_range read is already scoped to that window (mutually\nexclusive with row_range at the API level), then trimmed to tail_rows.","inputSchema":{"additionalProperties":false,"properties":{"library":{"type":"string"},"symbol":{"type":"string"},"start":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"tail_rows":{"default":1000,"type":"integer"}},"required":["library","symbol"],"type":"object"},"outputSchema":{"additionalProperties":true,"type":"object"},"_meta":{"fastmcp":{"tags":[]}}},{"name":"kdb_tables","description":"List tables defined in the kdb+ server.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"},"outputSchema":{"properties":{"result":{"items":{"type":"string"},"type":"array"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"_meta":{"fastmcp":{"tags":[]}}},{"name":"kdb_table_schema","description":"Column names/types of a kdb+ table (q meta: c=column, t=type char).","inputSchema":{"additionalProperties":false,"properties":{"table":{"type":"string"}},"required":["table"],"type":"object"},"outputSchema":{"properties":{"result":{"items":{"additionalProperties":true,"type":"object"},"type":"array"}},"required":["result"],"type":"object","x-fastmcp-wrap-result":true},"_meta":{"fastmcp":{"tags":[]}}},{"name":"kdb_select","description":"Filtered read of a kdb+ table (parameterized; never raw q).\n\nsymbol filters the table's symbol-typed column (empty/whitespace means\n\"no filter\", same as omitting it); start_time/end_time are ISO\ntimestamps filtering the first temporal column. Returns at most `limit`\nrows (hard cap 10000) -- bounded at the q select itself (`select[n]`),\nnot by truncating a fully materialized result.","inputSchema":{"additionalProperties":false,"properties":{"table":{"type":"string"},"symbol":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"start_time":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_time":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"limit":{"default":1000,"type":"integer"}},"required":["table"],"type":"object"},"outputSchema":{"additionalProperties":true,"type":"object"},"_meta":{"fastmcp":{"tags":[]}}}]}}

