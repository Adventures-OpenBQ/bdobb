# Runtime secrets go in Vercel project settings, never in VITE_* or source.
# These empty values intentionally leave the preview closed.
APP_ORIGIN=https://preview.example.com
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
GITHUB_ALLOWED_USER_IDS=
SESSION_EPOCH=
BACKEND_GATEWAY_ORIGIN=
BACKEND_GATEWAY_TOKEN=
NEWS_APPROVED_FEEDS_JSON=

# Trusted server-only identity relay: distinct from BACKEND_GATEWAY_TOKEN.
TABLE_RELAY_TOKEN=
# Optional, reviewed standard SSRM POST paths; mirror gateway ssrmRoutes.
SSRM_ROUTES_JSON=[]
TABLE_TIMEOUT_MS=65000
SSRM_TIMEOUT_MS=170000
