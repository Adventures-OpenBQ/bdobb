{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BDOBB",
  "version": "8.0.0",
  "identifier": "com.artcashin.bdobb",
  "build": {
    "beforeDevCommand": "node scripts/generate-capabilities.mjs && node scripts/sync-ios-icons.mjs && vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/generate-capabilities.mjs && node scripts/sync-ios-icons.mjs && vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "BDOBB",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http: wss: ws:",
        "frame-src": "https: http:",
        "frame-ancestors": "'none'",
        "object-src": "'none'",
        "worker-src": "'self' blob:",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.4"
    }
  }
}
