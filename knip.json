{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs", "web/entry.mjs", "deploy/reference-demo/vercel/build.mjs"],
  "ignore": ["LICENSES/**"],
  "ignoreBinaries": ["openssl"],
  "ignoreDependencies": ["@blocknote/core"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  }
}
