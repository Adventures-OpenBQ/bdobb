{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.mjs",
    "web/entry.mjs",
    "deploy/reference-demo/vercel/build.mjs",
    "deploy/table-service/*.mjs",
    "e2e/**/*.{ts,tsx,mjs}",
    "playwright.*.config.ts",
    "scripts/pivot-qualification/**/*.{ts,mjs}",
    "scripts/sort-reuse-benchmark/*.mjs",
    "scripts/applymodel-profile/**/*.{ts,mjs}"
  ],
  "ignore": [
    "LICENSES/**",
    "scripts/*.d.mts",
    "src/lib/reportModelActivation.ts"
  ],
  "ignoreBinaries": [
    "openssl"
  ],
  "ignoreDependencies": [
    "@blocknote/core",
    "audit-store-owned",
    "audit-reconcile",
    "profile-artifact",
    "stock-artifact",
    "before-artifact"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  }
}
