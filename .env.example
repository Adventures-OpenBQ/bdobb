# Copy to .env.local (gitignored) and fill in. Nothing here is required to run
# BDOBB; these seed the opt-in live-endpoint suite only.
#
#   set -a && . ./.env.local && set +a
#   OPENBB_LIVE=1 pnpm test:run src/test/integration
#
# The `set -a` line is required: Vitest does not load this file into
# process.env on its own, so it must be sourced into the shell first.
#
# Endpoints are private to whoever runs them, so they are never hardcoded in
# the suite and never committed.

# Set to 1 to enable the live-endpoint suite. Unset, the suite skips.
OPENBB_LIVE=

# The data backend: serves widgets.json. It answers 401 without credentials.
OPENBB_NAS_URL=
# Basic credentials for it, as user:password. Without these the widgets.json
# check cannot pass — the backend challenges every request.
OPENBB_NAS_AUTH=

# Agent Rita's base URL: serves agents.json.
OPENBB_RITA_URL=

# MCP servers, as a comma-separated id=url list.
#   OPENBB_MCP_URLS=openbb=https://openbb.example.ts.net:6901/mcp
OPENBB_MCP_URLS=

# Folder share targets: comma-separated absolute paths that "Send chat to…"
# folder-kind targets may write into. Read at build time (this file, via
# .env.local, or a real env var) by scripts/generate-capabilities.mjs -- not
# by the live-endpoint suite above. A folder left off this list cannot be
# written to at runtime.
#   VITE_SHARE_FOLDERS=/Users/<you>/Notes,/Users/<you>/Exports
VITE_SHARE_FOLDERS=

# Build-time defaults for a fresh install's Rita URL and MCP server.
# Seeded only when the key is absent from the settings file; explicit
# empty choices are never reseeded.
#   VITE_DEFAULT_RITA_URL=https://YOUR-TAILNET.ts.net:10443
#   VITE_DEFAULT_MCP_URL=https://YOUR-TAILNET.ts.net:11443/mcp
VITE_DEFAULT_RITA_URL=
VITE_DEFAULT_MCP_URL=
