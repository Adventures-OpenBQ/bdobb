// Add these to your tailnet policy (admin console → Access controls) so the
// demo node can advertise tag:reference-demo and turn on Funnel. Merge into
// the existing "tagOwners" and "nodeAttrs" blocks rather than duplicating them.

{
  "tagOwners": {
    // Replace with your own user/owner, same as tag:bdobb-gateway.
    "tag:reference-demo": ["autogroup:admin"],
  },

  "nodeAttrs": [
    {
      "target": ["tag:reference-demo"],
      "attr":   ["funnel"],
    },
  ],
}
