# --- Tailscale ---
# A reusable, pre-approved auth key TAGGED tag:reference-demo (create in the
# Tailscale admin console; ephemeral is fine — the node re-registers on restart
# from the ts-state volume). The tag must own the funnel nodeAttr — see
# tailnet-policy-snippet.hujson.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX  # scrub-allow: a placeholder, not a key

# The node's hostname. Public URL becomes https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=reference-backend

# --- Reference backend ---
# The demo frontend origin(s) allowed by CORS (comma-separated, no trailing /).
EXTRA_CORS_ORIGINS=https://reference.bdobb.secretoftheuniverse.com
