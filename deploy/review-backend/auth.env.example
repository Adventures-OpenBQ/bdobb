# Basic auth for the public URL.
#   cp auth.env.example auth.env && chmod 600 auth.env
#
# Caddy takes a bcrypt hash, never the password. Generate one with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
#
# QUOTE THE HASH WITH SINGLE QUOTES, exactly as shown below. A bcrypt hash is
# full of `$`, and compose's dotenv parser interpolates an unquoted value --
# `$2a$14$IU6z...` silently becomes `$2a$14/OC4...` because `$IU6z` expanded to
# nothing. The lock then rejects the right password with a 401 and no clue why.
# Single quotes turn interpolation off; double quotes do NOT.
REVIEW_USER=reviewer
REVIEW_PASSWORD_HASH='paste-the-hash-here'
