        },
        "subscription_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      },
      "required": [
        "protocol_version",
        "type",
        "subscription_id",
        "generation",
        "request_id",
        "cursor"
      ],
      "additionalProperties": false
    },
    {
