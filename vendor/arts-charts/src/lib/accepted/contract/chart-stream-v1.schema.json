          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "protocol_version",
        "type",
        "subscription_id",
        "generation",
        "request_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "type": {
          "const": "pong"
        },
        "subscription_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "protocol_version",
        "type",
        "subscription_id",
        "generation",
        "request_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "type": {
          "const": "snapshot_begin"
        },
        "subscription_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "view_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "view_floor": {
          "$ref": "#/$defs/floor"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "truncated": {
          "type": "boolean"
        },
        "item_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      },
      "required": [
        "protocol_version",
        "type",
        "subscription_id",
        "generation",
        "view",
        "view_key",
        "view_floor",
        "cursor",
        "coverage",
        "truncated",
        "item_count"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "type": {
          "const": "snapshot_chunk"
        },
        "subscription_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "chunk_index": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/tick"
              },
              {
                "$ref": "#/$defs/candle"
              }
            ]
          },
          "maxItems": 10000
        }
      },
      "required": [
        "protocol_version",
        "type",
        "subscription_id",
        "generation",
        "chunk_index",
        "items"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
