        },
        "through_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "candles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candle"
          },
          "maxItems": 2000
        }
      },
      "required": [
        "protocol_version",
        "type",
        "subscription_id",
        "generation",
        "from_cursor",
        "through_cursor",
        "candles"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "type": {
          "const": "candle_status"
