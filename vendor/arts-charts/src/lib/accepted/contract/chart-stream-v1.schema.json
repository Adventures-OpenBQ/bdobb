          "$ref": "#/$defs/cursor"
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "view_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "view_floor": {
          "$ref": "#/$defs/floor"
        },
        "status_seq": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/status"
          },
          "maxItems": 2000
        }
